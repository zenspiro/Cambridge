{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cambridge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // No routes yet: the app lives on cambridge.zenspiroapps.workers.dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cambridge",
      // Filled in by CI (scripts/set-d1-id.mjs) from the database name.
      // Not a secret. Local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // App files: diagrams, student uploads. Private, signed access only.
    { "binding": "FILES", "bucket_name": "cambridge" },
    // Cambridge source documents. Admin only, never served by URL.
    { "binding": "SOURCE", "bucket_name": "cambridge-source" }
  ],
  // Cloudflare Workers AI: the agent's judgement (which folders, what a file is, the run summary).
  // Called only through the signed /api/agent/ai endpoint. No key needed.
  "ai": { "binding": "AI" },
  "vars": {
    // Brand name is a setting, not hardcoded (brief 15.3). Placeholder until open decision 6.
    "APP_NAME": "Exam Prep",
    // Where "Run agent" starts GitHub Actions. Not secrets; the token is.
    "GITHUB_REPO": "zenspiro/Cambridge",
    "AGENT_WORKFLOW": "agent.yml",
    "AGENT_REF": "main",
    // Workers AI model for the agent (must support JSON mode). Change here to try another.
    "AI_MODEL": "@cf/meta/llama-3.1-70b-instruct",
    // Subject brain (topic tree): its GitHub workflow, the main model and the checking model from another
    // provider. The API keys are GitHub secrets (CLAUDE_API_KEY, GEMINI_API_KEY), never here.
    "BRAIN_WORKFLOW": "brain.yml",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "GEMINI_MODEL": "gemini-3.5-flash"
  }
}
