{
  "name": "cambridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run cf:types && next build",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "npm run cf:types && tsc --noEmit",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.ts\"",
    "check:inline": "node scripts/check-inline.ts",
    "check": "npm run typecheck && npm run test:unit && npm run check:inline",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply cambridge --local",
    "db:migrate:remote": "wrangler d1 migrations apply cambridge --remote",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/admin.mjs && node tests/e2e/library.mjs && node tests/e2e/folder.mjs && node tests/e2e/agent.mjs && node tests/e2e/brain.mjs && node tests/e2e/themes.mjs && node tests/e2e/accounts.mjs && node tests/e2e/profile.mjs && node tests/e2e/family.mjs && node tests/e2e/team.mjs",
    "build:worker": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "better-auth": "1.7.12",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
